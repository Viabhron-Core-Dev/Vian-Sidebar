<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_auto_scroll_pill"
    android:padding="8dp"
    android:elevation="8dp"
    android:gravity="center_vertical">

    <!-- Normal Record Controls Layout -->
    <LinearLayout
        android:id="@+id/layout_record_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="visible">

        <!-- Status Dot / Mic Indicator -->
        <ImageView
            android:id="@+id/iv_rec_status"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_audio_record"
            android:contentDescription="Recording Status" />

        <!-- Elapsed Timer -->
        <TextView
            android:id="@+id/tv_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginEnd="10dp" />

        <!-- Pause / Resume Toggle -->
        <ImageButton
            android:id="@+id/btn_pause_play"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@android:drawable/ic_media_pause"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Pause or Resume" />

        <!-- Next: Save current and start next -->
        <ImageButton
            android:id="@+id/btn_next"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@android:drawable/ic_media_next"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Next Recording" />

        <!-- Stop: Prompt Name and Save -->
        <ImageButton
            android:id="@+id/btn_stop"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_stop"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Stop and Name" />

        <!-- Vertical Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:layout_marginHorizontal="6dp"
            android:background="#55FFFFFF" />

        <!-- Close Panel & Exit -->
        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close Panel" />
    </LinearLayout>

    <!-- Stop & Naming Inline Layout -->
    <LinearLayout
        android:id="@+id/layout_name_input"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/et_recording_name"
            android:layout_width="160dp"
            android:layout_height="38dp"
            android:background="#22FFFFFF"
            android:textColor="#FFFFFF"
            android:textColorHint="#99FFFFFF"
            android:textSize="13sp"
            android:paddingHorizontal="8dp"
            android:singleLine="true"
            android:hint="Recording name" />

        <Button
            android:id="@+id/btn_save_name"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:text="Save"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1DB954" />

        <ImageButton
            android:id="@+id/btn_cancel_name"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Discard Recording" />
    </LinearLayout>

</LinearLayout>
