<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="4dp"
    android:paddingBottom="6dp">

    <!-- Display Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom|end"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:paddingBottom="4dp">

        <!-- Top Display (Full calculation expression with cursor) -->
        <HorizontalScrollView
            android:id="@+id/scroll_expression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:fillViewport="true">

            <TextView
                android:id="@+id/tv_expression"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:textColor="#9E9E9E"
                android:textSize="16sp"
                android:fontFamily="sans-serif-light"
                android:lines="1"
                android:singleLine="true" />
        </HorizontalScrollView>

        <!-- Bottom Display (Active result / calculation, auto-scaled) -->
        <HorizontalScrollView
            android:id="@+id/scroll_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:scrollbars="none"
            android:fillViewport="true">

            <TextView
                android:id="@+id/tv_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif"
                android:lines="1"
                android:singleLine="true" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Extended Functions Toggle Bar (Drawer Handle) -->
    <LinearLayout
        android:id="@+id/btn_toggle_drawer"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackground"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_drawer_arrow"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@android:drawable/arrow_down_float"
            android:tint="#757575"
            android:contentDescription="Toggle Extended Options" />
    </LinearLayout>

    <!-- Extended Drawer Options (Non-scientific utility panel + Cursor navigation arrows) -->
    <LinearLayout
        android:id="@+id/layout_extended_drawer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/btn_cursor_left"
                style="@style/CalcBtnSmall"
                android:text="◀"
                android:textColor="#80D8FF" />

            <TextView
                android:id="@+id/btn_cursor_right"
                style="@style/CalcBtnSmall"
                android:text="▶"
                android:textColor="#80D8FF" />

            <TextView
                android:id="@+id/btn_paren_open"
                style="@style/CalcBtnSmall"
                android:text="("
                android:textColor="#B0BEC5" />

            <TextView
                android:id="@+id/btn_paren_close"
                style="@style/CalcBtnSmall"
                android:text=")"
                android:textColor="#B0BEC5" />

            <TextView
                android:id="@+id/btn_power"
                style="@style/CalcBtnSmall"
                android:text="^"
                android:textColor="#B0BEC5" />

            <TextView
                android:id="@+id/btn_sqrt"
                style="@style/CalcBtnSmall"
                android:text="√"
                android:textColor="#B0BEC5" />
        </TableRow>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            android:background="#26FFFFFF" />
    </LinearLayout>

    <!-- Keypad Grid (Standard Numbers & Operators) -->
    <TableLayout
        android:id="@+id/tableLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="*">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="3dp">
            <TextView android:text="C" style="@style/CalcBtn" android:textColor="#FF7043"/>
            <TextView android:text="DEL" style="@style/CalcBtn" android:textColor="#FF7043"/>
            <TextView android:text="%" style="@style/CalcBtn" android:textColor="#FF7043"/>
            <TextView android:text="÷" style="@style/CalcBtn" android:textColor="#FF7043"/>
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="3dp">
            <TextView android:text="7" style="@style/CalcBtn"/>
            <TextView android:text="8" style="@style/CalcBtn"/>
            <TextView android:text="9" style="@style/CalcBtn"/>
            <TextView android:text="x" style="@style/CalcBtn" android:textColor="#FF7043"/>
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="3dp">
            <TextView android:text="4" style="@style/CalcBtn"/>
            <TextView android:text="5" style="@style/CalcBtn"/>
            <TextView android:text="6" style="@style/CalcBtn"/>
            <TextView android:text="-" style="@style/CalcBtn" android:textColor="#FF7043"/>
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="3dp">
            <TextView android:text="1" style="@style/CalcBtn"/>
            <TextView android:text="2" style="@style/CalcBtn"/>
            <TextView android:text="3" style="@style/CalcBtn"/>
            <TextView android:text="+" style="@style/CalcBtn" android:textColor="#FF7043"/>
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="40dp">
            <TextView android:text="0" style="@style/CalcBtn"/>
            <TextView android:text="00" style="@style/CalcBtn"/>
            <TextView android:text="." style="@style/CalcBtn"/>
            <TextView
                android:text="="
                style="@style/CalcBtn"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/calc_eq_bg"/>
        </TableRow>

    </TableLayout>

</LinearLayout>
